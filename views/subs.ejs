<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0f0f0f">
<title><%= lang === 'ru' ? 'Подписки' : 'Obunalarim' %> — <%= siteName || 'LuminaTube' %></title>
<link rel="stylesheet" href="/static/css/style.css">
<link rel="stylesheet" href="/static/css/ui-fix.css?v=3">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<script src="/static/js/app.js"></script>
</head>
<body>
<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<main class="main">
<div class="wrap">
<h2 class="sect-title"><%= lang === 'ru' ? 'Мои подписки' : 'Obunalarim' %></h2>
<% if (streams && streams.length > 0) { %>
  <div class="grid">
    <% streams.forEach(function(s) { %>
      <a class="card" href="/watch/<%= s.id %>">
        <div class="thumb">
          <img src="<%= s.thumbnail || '/img/no-thumb.svg' %>" alt="" loading="lazy">
          <% if (s.status === 'live') { %>
            <span class="pill live" style="position:absolute;bottom:8px;right:8px"><%= lang === 'ru' ? 'В ЭФИРЕ' : 'JONLI' %></span>
          <% } else if (s.duration) { %>
            <span class="badge"><%= s.duration %></span>
          <% } %>
        </div>
        <div class="meta">
          <span class="avatar sm">
            <% if (s.avatar) { %>
              <img src="<%= s.avatar %>" alt="" style="width:100%;height:100%;object-fit:cover">
            <% } else { %>
              <%= s.user_login.charAt(0).toUpperCase() %>
            <% } %>
          </span>
          <div style="min-width:0">
            <h3><%= s.title %></h3>
            <div class="sub"><%= s.user_title || s.user_login %></div>
            <div class="sub"><%= s.views %> <%= lang === 'ru' ? 'просмотров' : 'marta ko‘rilgan' %></div>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="empty"><%= lang === 'ru' ? 'У ваших подписок пока нет эфиров' : 'Hozircha efirlar yo‘q' %></div>
<% } %>
</div>
</main>
<div class="toast" id="toast"></div>
</body>
</html>
